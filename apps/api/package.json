{
  "name": "@kontiva/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "db:migrate": "node dist/cli.js migrar",
    "db:rollback": "node dist/cli.js revertir",
    "cli": "node dist/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@kontiva/shared": "workspace:*",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/throttler": "^6.7.1",
    "@xmldom/xmldom": "^0.9.12",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "facturacionelectronicapy-xmlgen": "1.0.283",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "kysely": "^0.28.20",
    "node-forge": "^1.4.3",
    "nodemailer": "^10.5.0",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xml-crypto": "^6.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
