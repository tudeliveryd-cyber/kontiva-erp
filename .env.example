# API
PORT=3000
NODE_ENV=development
# Conexión de la API (rol sin privilegios, RLS siempre activo)
DATABASE_URL=postgresql://kontiva_app:kontiva_app@localhost:5432/kontiva
# Conexión de migraciones (rol dueño del esquema)
DATABASE_OWNER_URL=postgresql://kontiva_owner:kontiva_owner@localhost:5432/kontiva
# Secreto para firmar tokens de acceso (mínimo 32 caracteres, aleatorio)
JWT_SECRET=cambie-esto-por-un-secreto-aleatorio-de-64-caracteres-minimo
# Origen del frontend (CORS y enlaces de correo)
WEB_URL=http://localhost:5173
# Correo transaccional (vacío = los correos se muestran en el log)
SMTP_URL=
MAIL_FROM="KONTIVA ERP <no-responder@kontiva.com.py>"
